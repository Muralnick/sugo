# --- Errors and hints ---------------------------------------------------------

msgid "Sugo reads PDF, DOCX, PNG, JPEG, WEBP and XML files."
msgstr "Sugo legge file PDF, DOCX, PNG, JPEG, WEBP e XML."

msgid "Save the image as a still PNG, JPEG or WEBP."
msgstr "Salva l'immagine come PNG, JPEG o WEBP non animato."

msgid "The file may be damaged; open it and save it again."
msgstr "Il file potrebbe essere danneggiato; aprilo e salvalo di nuovo."

msgid "Reduce the image size, or split it."
msgstr "Riduci le dimensioni dell'immagine, oppure dividila."

msgid "Save an unprotected copy of the PDF and convert that."
msgstr "Salva una copia non protetta del PDF e converti quella."

msgid "Split the PDF into smaller files."
msgstr "Dividi il PDF in file più piccoli."

msgid "Try again; if it fails again, run: sugo doctor"
msgstr "Riprova; se non riesce di nuovo, esegui: sugo doctor"

msgid "Fix the file or variable named above; run: sugo doctor"
msgstr "Correggi il file o la variabile indicati sopra; esegui: sugo doctor"

msgid "The lite level is not installed."
msgstr "Il livello lite non è installato."

msgid "Reinstall Sugo; a bundled file was altered or damaged."
msgstr "Reinstalla Sugo: un file incluso è stato alterato o danneggiato."

msgid "Check the output folder: free space and permission to write."
msgstr "Controlla la cartella di uscita: spazio libero e permesso di scrittura."

msgid "The clipboard cannot be read."
msgstr "Impossibile leggere gli appunti."

msgid "On Linux, install wl-clipboard (Wayland) or xclip (X11)."
msgstr "Su Linux, installa wl-clipboard (Wayland) o xclip (X11)."

msgid "The clipboard holds no image."
msgstr "Negli appunti non c'è un'immagine."

msgid "Copy an image or take a screenshot; to convert a file, run: sugo FILE"
msgstr "Copia un'immagine o fai uno screenshot; per convertire un file, esegui: sugo FILE"

